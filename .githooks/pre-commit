#!/bin/sh
set -e

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/update-engineering-changelog.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/update-engineering-changelog.ps1
else
  echo "PowerShell is required to update docs/dev/ENGINEERING_CHANGELOG.md" >&2
  exit 1
fi
